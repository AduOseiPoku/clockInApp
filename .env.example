# Django Configuration
DEBUG=False
SECRET_KEY=replace-with-a-secure-random-key-at-least-50-characters
ALLOWED_HOSTS=your-domain.com,*.your-domain.com,localhost
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Database Configuration (PostgreSQL with SQLite fallback)
USE_SQLITE=False
DB_NAME=school_clockin_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=your-postgres-service-name-or-host
DB_PORT=5432

# School Billing Settings
DEFAULT_CANTEEN_FEE=10.00
CURRENT_ACADEMIC_PERIOD=Term 1 - 2026
SCHOOL_NAME=Geosaka Model School
CURRENCY_SYMBOL=GH₵
